# Kopieer dit bestand naar .env en vul de echte waarden in.
# .env wordt NOOIT gecommit (zie .gitignore). Voor Cloudflare Pages en
# GitHub Actions zet je deze waarden als secrets/env-vars in die platforms
# (zie SETUP.md voor exacte instructies).

# ---------------------------------------------------------------------------
# Bol.com affiliate
# ---------------------------------------------------------------------------
# Client credentials voor de Bol Marketing/Catalog API (OAuth2 client_credentials
# flow). Nodig zodra je van de sample-CSV overstapt op de echte feed/API.
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
# Je Bol partner/site-ID, geinjecteerd in elke affiliate-deeplink.
BOL_SITE_ID=
# Lokaal pad of HTTPS-URL naar een (via de Marketing API) gedownloade
# Bol-feed (CSV). Laat leeg om de sample te gebruiken; de build-pipeline
# valt terug op data/sample/bol-sample.csv.
BOL_FEED_PATH=

# ---------------------------------------------------------------------------
# Affiliate-netwerk-feeds (TradeTracker / Daisycon / Awin) voor drogisterijen
# ---------------------------------------------------------------------------
# Eén URL + (optioneel) subId/tracking-token per feed. De sample-feed bundelt
# Kruidvat en Etos in één bestand met een 'winkel'-kolom; voeg voor een
# losse drogist-feed een nieuwe FEED_<SHOP>_URL toe en een entry in
# src/adapters/affiliate-feed.ts (FEED_CONFIGS).
FEED_DROGIST_URL=
FEED_DROGIST_SUBID=

# ---------------------------------------------------------------------------
# Amazon Product Advertising API (PA-API 5.0) -- UITGESCHAKELD tot je
# kwalificerende sales hebt (zie SETUP.md). De adapter (src/adapters/amazon.ts)
# is gebouwd maar bewust niet opgenomen in de actieve registry.
# ---------------------------------------------------------------------------
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.nl
AMAZON_REGION=eu-west-1
