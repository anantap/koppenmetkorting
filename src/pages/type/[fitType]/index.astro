---
import Base from '../../../layouts/Base.astro';
import ProductTable from '../../../components/ProductTable.astro';
import { rankedGroups, allFitTypes } from '../../../lib/data.js';

export function getStaticPaths() {
  return allFitTypes().map((fitType) => ({
    params: { fitType },
    props: { fitType },
  }));
}

const { fitType } = Astro.props as { fitType: string };
const groups = rankedGroups().filter((g) => g.fitType === fitType);
---

<Base title={`Opzetborstels voor ${fitType} — Koppen met Korting`}>
  <p><a href="/">&larr; Alle koppen</a></p>
  <h1>Opzetborstels: {fitType}</h1>
  <p class="muted">{groups.length} aanbieding(en) gevonden.</p>
  <ProductTable groups={groups} />
</Base>
